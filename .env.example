# websocket-server (giwa) 환경변수
#
# 코드가 실제로 읽는 키만 담는다 (`env::var` 호출 기준).
# 키를 추가하거나 제거하면 이 파일도 함께 갱신할 것.
# 실제 값은 `.env`(gitignore)에 넣는다.

# ─────────────────────────────────────────────
# 필수 — 없으면 기동 시 panic
# ─────────────────────────────────────────────

APP_NAME="WEBSOCKET_SERVER"

# 체인 RPC (WebSocket). eth_subscribe("logs")를 지원해야 한다.
MAIN_RPC_URL=
SUB_RPC_URL_1=
SUB_RPC_URL_2=
# RPC 호출 타임아웃 (밀리초)
RPC_TIME_OUT=10000

# 컨트랙트 주소
# BONDING_CURVE — 본딩커브 컨트랙트. 커브 스트림이 이 주소로 로그를 필터링한다.
# WETH — giwa wrapped native. quote 토큰이 native인지 판별하는 기준.
BONDING_CURVE=
WETH=

DATABASE_URL="postgres://user:password@localhost:5432/pump"
REDIS_URL="redis://localhost:6379"

DEFAULT_DELAY=500
METRICS_REPORT_INTERVAL=10000

# Redis 캐시 TTL (밀리초)
WHITELIST_EXPIRATION=172800000
ACCOUNT_INFO_EXPIRATION=300000
TOKEN_INFO_EXPIRATION=43200000
MARKET_INFO_EXPIRATION=1000
LATEST_PRICE_EXPIRATION=5000

# Postgres 풀
PG_MAX_CONNECTIONS=10
PG_MIN_CONNECTIONS=2
PG_MAX_LIFETIME=1800
PG_ACQUIRE_TIMEOUT=5
PG_IDLE_TIMEOUT=60
PG_STATEMENT_CACHE_CAPACITY=1000
PG_SSL_MODE=disable

# Redis 풀
REDIS_POOL_MAX_SIZE=100
REDIS_POOL_WAIT_TIMEOUT_SECS=5
REDIS_POOL_CREATE_TIMEOUT_SECS=2
REDIS_POOL_RECYCLE_TIMEOUT_SECS=1

# ─────────────────────────────────────────────
# 선택 — 미설정 시 아래 기본값
# ─────────────────────────────────────────────

IP="0.0.0.0"                    # 기본 127.0.0.1 — 컨테이너에선 반드시 0.0.0.0 로 둘 것.
                                # loopback 바인딩이면 컨테이너 내부 healthcheck 는 통과하지만
                                # ECS awsvpc 의 ENI 주소로는 접속이 안 돼 ALB 타겟이 죽는다.
PORT="8001"                     # 기본 8001
MODE=mainnet                    # mainnet | testnet
HEALTH_CHECK_INTERVAL=6000      # 기본 60

# pgbouncer 등 replica 엔드포인트. 미설정 시 DATABASE_URL 사용.
# REPLICA_DATABASE_URL=

# 모든 Redis 키에 붙는 prefix. 같은 Redis를 여러 배포가 공유할 때 충돌 방지.
# 미설정/빈 값이면 prefix 없음. 예: "GIWA" → 모든 키가 "GIWA:..." 로 시작.
# prefix 설정 시 flush_all 이 FLUSHALL → SCAN+DEL(prefix*) 로 자동 전환된다.
REDIS_KEY_PREFIX=""

# Vault 주소. 설정 시 해당 vault의 buy/sell을 actor로 인정한다. 미설정이면 빈 문자열.
# GIFT_VAULT=
# BURN_VAULT=

# 계정 기본 프로필 이미지 후보. 계정 생성 시 1~5 중 하나를 무작위로 고른다.
# 미설정이면 https://default-image.com/default.png 로 대체된다.
# DEFAULT_IMAGE_1=
# DEFAULT_IMAGE_2=
# DEFAULT_IMAGE_3=
# DEFAULT_IMAGE_4=
# DEFAULT_IMAGE_5=

# CHANNEL_SIZE=1000               # 이벤트 채널 버퍼 크기
# STREAM_TIMEOUT=1800000          # 스트림 무응답 재연결 임계 (ms, 기본 30분)
# REDIS_COMMAND_TIMEOUT_MS=500
# SQL_COMMAND_TIMEOUT_MS=500

# 참고: RUST_LOG 은 동작하지 않는다. main.rs 가 EnvFilter 대신
# with_max_level(Level::INFO) 로 로그 레벨을 하드코딩하고 있다.

# ─────────────────────────────────────────────
# stress-test 바이너리 전용 (서버 기동과 무관)
# ─────────────────────────────────────────────

# STRESS_TEST_SERVER_URL="ws://localhost:8001/ws"
# STRESS_TEST_TOKEN_ADDRESSES="0x...,0x..."
# STRESS_TEST_STRESS_COUNT=500
